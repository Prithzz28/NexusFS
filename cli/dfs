#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# DFS CLI Client
# Executable command-line interface for the Distributed File Storage System
# Supports: login, put, get, ls, rm, status, nodes
# ─────────────────────────────────────────────────────────────────────

set -euo pipefail

# ── Configuration ────────────────────────────────────────────────────
DFS_MASTER_URL="${DFS_MASTER_URL:-http://localhost:8080}"
DFS_CONFIG_DIR="${HOME}/.dfs"
DFS_TOKEN_FILE="${DFS_CONFIG_DIR}/token"

# Colors
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

# ── Helpers ──────────────────────────────────────────────────────────
log_info() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1" >&2; }

ensure_config_dir() {
    mkdir -p "$DFS_CONFIG_DIR"
}

get_token() {
    if [ ! -f "$DFS_TOKEN_FILE" ]; then
        log_error "Not logged in. Run: dfs login"
        exit 1
    fi
    cat "$DFS_TOKEN_FILE"
}

api_call() {
    local method="$1"
    local path="$2"
    shift 2
    local token
    token=$(get_token 2>/dev/null || echo "")

    local auth_header=""
    if [ -n "$token" ]; then
        auth_header="-H Authorization: Bearer $token"
    fi

    curl -s -X "$method" \
        -H "Content-Type: application/json" \
        $auth_header \
        "${DFS_MASTER_URL}${path}" \
        "$@"
}

api_call_no_auth() {
    local method="$1"
    local path="$2"
    shift 2

    curl -s -X "$method" \
        -H "Content-Type: application/json" \
        "${DFS_MASTER_URL}${path}" \
        "$@"
}

format_size() {
    local size=$1
    if [ "$size" -ge 1073741824 ]; then
        echo "$(awk "BEGIN {printf \"%.2f GB\", $size/1073741824}")"
    elif [ "$size" -ge 1048576 ]; then
        echo "$(awk "BEGIN {printf \"%.2f MB\", $size/1048576}")"
    elif [ "$size" -ge 1024 ]; then
        echo "$(awk "BEGIN {printf \"%.2f KB\", $size/1024}")"
    else
        echo "${size} B"
    fi
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_login() {
    ensure_config_dir
    local username password

    if [ $# -ge 2 ]; then
        username="$1"
        password="$2"
    else
        read -p "Username: " username
        read -sp "Password: " password
        echo
    fi

    local response
    response=$(api_call_no_auth POST "/api/auth/login" \
        -d "{\"username\":\"$username\",\"password\":\"$password\"}")

    local success
    success=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',''))" 2>/dev/null || echo "")

    if [ "$success" = "True" ] || [ "$success" = "true" ]; then
        local token
        token=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['token'])" 2>/dev/null)
        echo "$token" > "$DFS_TOKEN_FILE"
        chmod 600 "$DFS_TOKEN_FILE"
        log_info "Logged in as ${CYAN}${username}${NC}"
    else
        local error_msg
        error_msg=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',{}).get('message','Unknown error'))" 2>/dev/null || echo "Login failed")
        log_error "$error_msg"
        exit 1
    fi
}

cmd_register() {
    ensure_config_dir
    local username email password

    if [ $# -ge 3 ]; then
        username="$1"
        email="$2"
        password="$3"
    else
        read -p "Username: " username
        read -p "Email: " email
        read -sp "Password: " password
        echo
    fi

    local response
    response=$(api_call_no_auth POST "/api/auth/register" \
        -d "{\"username\":\"$username\",\"email\":\"$email\",\"password\":\"$password\"}")

    local success
    success=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',''))" 2>/dev/null || echo "")

    if [ "$success" = "True" ] || [ "$success" = "true" ]; then
        local token
        token=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['token'])" 2>/dev/null)
        echo "$token" > "$DFS_TOKEN_FILE"
        chmod 600 "$DFS_TOKEN_FILE"
        log_info "Registered and logged in as ${CYAN}${username}${NC}"
    else
        local error_msg
        error_msg=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error',{}).get('message','Unknown error'))" 2>/dev/null || echo "Registration failed")
        log_error "$error_msg"
        exit 1
    fi
}

cmd_put() {
    if [ $# -lt 1 ]; then
        log_error "Usage: dfs put <file>"
        exit 1
    fi

    local filepath="$1"
    if [ ! -f "$filepath" ]; then
        log_error "File not found: $filepath"
        exit 1
    fi

    local filename
    filename=$(basename "$filepath")
    local filesize
    filesize=$(stat -c%s "$filepath" 2>/dev/null || stat -f%z "$filepath" 2>/dev/null)
    local content_type
    content_type=$(file -b --mime-type "$filepath" 2>/dev/null || echo "application/octet-stream")

    echo -e "${CYAN}Uploading:${NC} $filename ($(format_size "$filesize"))"

    # 1. Init upload
    local init_response
    init_response=$(api_call POST "/api/files/init-upload" \
        -d "{\"fileName\":\"$filename\",\"fileSize\":$filesize,\"contentType\":\"$content_type\"}")

    local session_id
    session_id=$(echo "$init_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['sessionId'])" 2>/dev/null)
    local total_chunks
    total_chunks=$(echo "$init_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['totalChunks'])" 2>/dev/null)
    local chunk_size
    chunk_size=$(echo "$init_response" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['chunkSize'])" 2>/dev/null)

    if [ -z "$session_id" ] || [ "$session_id" = "None" ]; then
        log_error "Failed to initiate upload"
        echo "$init_response" | python3 -m json.tool 2>/dev/null || echo "$init_response"
        exit 1
    fi

    # 2. Upload chunks
    local chunk_index=0
    local offset=0
    while [ "$offset" -lt "$filesize" ]; do
        local this_size=$chunk_size
        local remaining=$((filesize - offset))
        if [ "$remaining" -lt "$this_size" ]; then
            this_size=$remaining
        fi

        echo -ne "\r  Chunk $((chunk_index + 1))/$total_chunks..."

        local token
        token=$(get_token)
        dd if="$filepath" bs=1 skip="$offset" count="$this_size" 2>/dev/null | \
            curl -s -X POST \
                -H "Authorization: Bearer $token" \
                -H "Content-Type: application/octet-stream" \
                "${DFS_MASTER_URL}/api/files/${session_id}/chunks/${chunk_index}" \
                --data-binary @- > /dev/null

        offset=$((offset + this_size))
        chunk_index=$((chunk_index + 1))
    done
    echo

    # 3. Complete upload
    api_call POST "/api/files/${session_id}/complete" > /dev/null

    log_info "Upload complete: ${CYAN}${filename}${NC} ($total_chunks chunks)"
}

cmd_get() {
    if [ $# -lt 1 ]; then
        log_error "Usage: dfs get <file-id> [output-path]"
        exit 1
    fi

    local file_id="$1"
    local output_path="${2:-}"

    # Get file details first
    local details
    details=$(api_call GET "/api/files/${file_id}")
    local filename
    filename=$(echo "$details" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['fileName'])" 2>/dev/null)

    if [ -z "$filename" ] || [ "$filename" = "None" ]; then
        log_error "File not found: $file_id"
        exit 1
    fi

    if [ -z "$output_path" ]; then
        output_path="$filename"
    fi

    echo -e "${CYAN}Downloading:${NC} $filename -> $output_path"

    local token
    token=$(get_token)
    curl -s -X GET \
        -H "Authorization: Bearer $token" \
        "${DFS_MASTER_URL}/api/files/${file_id}/download" \
        -o "$output_path"

    log_info "Downloaded: ${CYAN}${output_path}${NC}"
}

cmd_ls() {
    local response
    response=$(api_call GET "/api/files?size=50")

    echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if not data.get('success'):
    print('Error:', data.get('error', {}).get('message', 'Unknown'))
    sys.exit(1)

files = data['data'].get('content', [])
if not files:
    print('No files found.')
    sys.exit(0)

print(f'{'ID':<38} {'Name':<30} {'Size':>12} {'Status':<12} {'Created'}')
print('-' * 120)
for f in files:
    size = f['fileSize']
    if size >= 1073741824:
        size_str = f'{size/1073741824:.2f} GB'
    elif size >= 1048576:
        size_str = f'{size/1048576:.2f} MB'
    elif size >= 1024:
        size_str = f'{size/1024:.2f} KB'
    else:
        size_str = f'{size} B'

    created = f.get('createdAt', '')[:19]
    print(f\"{f['id']:<38} {f['fileName']:<30} {size_str:>12} {f['status']:<12} {created}\")

total = data['data'].get('totalElements', len(files))
print(f'\nTotal: {total} files')
" 2>/dev/null || echo "$response"
}

cmd_rm() {
    if [ $# -lt 1 ]; then
        log_error "Usage: dfs rm <file-id>"
        exit 1
    fi

    local file_id="$1"
    local response
    response=$(api_call DELETE "/api/files/${file_id}")

    local success
    success=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',''))" 2>/dev/null || echo "")

    if [ "$success" = "True" ] || [ "$success" = "true" ]; then
        log_info "File deleted: ${file_id}"
    else
        log_error "Failed to delete file"
        echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
    fi
}

cmd_status() {
    local response
    response=$(api_call_no_auth GET "/api/status")
    echo -e "${CYAN}DFS Cluster Status${NC}"
    echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"

    echo
    echo -e "${CYAN}Storage Nodes${NC}"
    local nodes_response
    nodes_response=$(api_call GET "/api/nodes" 2>/dev/null || echo '{}')
    echo "$nodes_response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
nodes = data.get('data', [])
if not nodes:
    print('No nodes registered.')
    sys.exit(0)

print(f\"{'Node ID':<15} {'Host':>20} {'Status':<10} {'Used':>12} {'Available':>12} {'Last HB'}\")
print('-' * 100)
for n in nodes:
    used = n.get('usedStorageBytes', 0)
    avail = n.get('availableStorageBytes', 0)
    hb = (n.get('lastHeartbeat') or 'never')[:19]
    host = f\"{n['host']}:{n['port']}\"
    print(f\"{n['nodeId']:<15} {host:>20} {n['status']:<10} {used:>12,} {avail:>12,} {hb}\")
" 2>/dev/null || echo "$nodes_response"
}

cmd_nodes() {
    cmd_status
}

cmd_logout() {
    rm -f "$DFS_TOKEN_FILE"
    log_info "Logged out"
}

cmd_help() {
    cat <<EOF
${CYAN}DFS CLI${NC} - Distributed File Storage Client

${YELLOW}Usage:${NC}
  dfs <command> [options]

${YELLOW}Commands:${NC}
  login [username] [password]           Login to the DFS cluster
  register [user] [email] [password]    Register a new account
  put <file>                            Upload a file
  get <file-id> [output-path]           Download a file
  ls                                    List your files
  rm <file-id>                          Delete a file
  status                                Show cluster status & nodes
  nodes                                 List storage nodes
  logout                                Clear stored credentials
  help                                  Show this help

${YELLOW}Environment:${NC}
  DFS_MASTER_URL    Master server URL (default: http://localhost:8080)

${YELLOW}Examples:${NC}
  dfs login admin password123
  dfs put ./myfile.txt
  dfs ls
  dfs get abc-123-def
  dfs rm abc-123-def
  dfs status
EOF
}

# ── Main ─────────────────────────────────────────────────────────────
main() {
    if [ $# -lt 1 ]; then
        cmd_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        login)    cmd_login "$@" ;;
        register) cmd_register "$@" ;;
        put)      cmd_put "$@" ;;
        get)      cmd_get "$@" ;;
        ls)       cmd_ls "$@" ;;
        rm)       cmd_rm "$@" ;;
        status)   cmd_status "$@" ;;
        nodes)    cmd_nodes "$@" ;;
        logout)   cmd_logout "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            log_error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
